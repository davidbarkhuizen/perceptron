#!/usr/bin/env bash

set -euo pipefail

option="${1:-}"

venv_root=".venv"
os_packages="python3-tk"

clean () {

    rm -rf .pytest_cache
    rm -rf perceptron/__pycache__
    rm -rf perceptron/demos/__pycache__
    rm -rf tests/__pycache__
}

install_os_packages () {

    echo "installing os packages ..."
    sudo apt install "$os_packages"
    echo "... installed os packages"
}

create_venv () {

    echo "creating virtual environment @ $venv_root ..."
    python3 -m venv "$venv_root"
    echo "... created virtual environment @ $venv_root"
}

activate_venv () {

    source "$venv_root/bin/activate"
    echo "$(python --version) venv @ $(which python)"
}

deactivate_venv () {

    deactivate
}

install_and_upgrade_pip () {

    python -m pip install --upgrade pip
    echo "$(python -m pip --version)"
}

install_python_modules () {

    echo "installing python modules ..."
    python -m pip install -r requirements.txt
    echo "... installed python modules"
}


setup () {

    install_os_packages
    create_venv
    activate_venv
    install_and_upgrade_pip
    install_python_modules
    deactivate_venv
}

run_tests () {

    activate_venv
    python3 -m pytest --verbose tests/
    deactivate_venv
}

demo () {

    activate_venv
    python3 -m perceptron.demos.demo
    deactivate_venv
}

demo-cardinality-sweep () {

    activate_venv
    python3 -m perceptron.demos.demo_cardinality_sweep
    deactivate_venv
}

demo-unreachable-class () {

    activate_venv
    python3 -m perceptron.demos.demo_unreachable_class
    deactivate_venv
}

demo-nonrepresentable-target () {

    activate_venv
    python3 -m perceptron.demos.demo_nonrepresentable_target
    deactivate_venv
}

demo-backprop-xor () {

    activate_venv
    python3 -m perceptron.demos.demo_backprop_xor
    deactivate_venv
}

demo-backprop-architecture-sweep () {

    activate_venv
    python3 -m perceptron.demos.demo_backprop_architecture_sweep
    deactivate_venv
}

demo-backprop-circular-target () {

    activate_venv
    python3 -m perceptron.demos.demo_backprop_circular_target
    deactivate_venv
}

demo-backprop-vs-linear () {

    activate_venv
    python3 -m perceptron.demos.demo_backprop_vs_linear
    deactivate_venv
}

demo-digit-recognition () {

    activate_venv
    python3 -m perceptron.demos.demo_digit_recognition
    deactivate_venv
}

demo-digit-capture () {

    activate_venv
    python3 -m perceptron.demos.demo_digit_capture
    deactivate_venv
}

demo-mnist-recognition () {

    activate_venv
    python3 -m perceptron.demos.demo_mnist_recognition
    deactivate_venv
}

usage () {
    echo "usage: invoke [ clean | setup | test | demo | demo-cardinality-sweep | demo-unreachable-class | demo-nonrepresentable-target | demo-backprop-xor | demo-backprop-architecture-sweep | demo-backprop-circular-target | demo-backprop-vs-linear | demo-digit-recognition | demo-digit-capture | demo-mnist-recognition ]"
}

case "$option" in

    clean)
        clean
    ;;

    setup)
        setup
    ;;

    test)
        clean
        run_tests
    ;;

    demo)
        demo
    ;;

    demo-cardinality-sweep)
        demo-cardinality-sweep
    ;;

    demo-unreachable-class)
        demo-unreachable-class
    ;;

    demo-nonrepresentable-target)
        demo-nonrepresentable-target
    ;;

    demo-backprop-xor)
        demo-backprop-xor
    ;;

    demo-backprop-architecture-sweep)
        demo-backprop-architecture-sweep
    ;;

    demo-backprop-circular-target)
        demo-backprop-circular-target
    ;;

    demo-backprop-vs-linear)
        demo-backprop-vs-linear
    ;;

    demo-digit-recognition)
        demo-digit-recognition
    ;;

    demo-digit-capture)
        demo-digit-capture
    ;;

    demo-mnist-recognition)
        demo-mnist-recognition
    ;;

    *)
        usage
    ;;
esac
